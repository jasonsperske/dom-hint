{
  "manifest_version": 3,
  "name": "DOM Hints",
  "version": "1.3.1",
  "description": "Observe DOM mutations triggered by user interactions",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-observer": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Toggle DOM mutation observer"
    }
  },
  "options_page": "options.html"
}
